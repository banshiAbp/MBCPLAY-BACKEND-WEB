{
  "compilerOptions": {
    "target": "es6",
    "module": "NodeNext",
    "jsx": "react",
    "strict": true,
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["dom", "dom.iterable", "es2018"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
